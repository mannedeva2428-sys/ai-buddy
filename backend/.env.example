# MongoDB connection string
# Local MongoDB example: mongodb://localhost:27017
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGO_URI=mongodb://localhost:27017mongodb.net
DATABASE_NAME=voice_assistant_db

# JWT settings
SECRET_KEY=change_this_to_a_long_random_secret_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - frontend URL
FRONTEND_URL=http://localhost:5173

# Optional: OpenAI key for smarter AI replies.
# If left empty, the app falls back to a simple built-in assistant.
OPENAI_API_KEY=
