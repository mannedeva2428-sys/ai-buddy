# MongoDB connection string
# Local MongoDB example: mongodb://localhost:27017/ai_buddy
# MongoDB Atlas example: mongodb+srv://<user>:<password>@cluster.mongodb.net/ai_buddy?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ai_buddy
DATABASE_NAME=ai_buddy


# JWT settings
SECRET_KEY=change_this_to_a_long_random_secret_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - frontend URL
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=

# Optional: OpenAI or Gemini keys for AI response generation.
# If left empty, the app uses built-in smart assistant commands.
OPENAI_API_KEY=
GEMINI_API_KEY=
