PS D:\ai-voice-assistant> (Set-ExecutionPolicy -Scope Process -ExecutionPolicy RemoteSigned) ; (& d:\ai-voice-assistant\backend\.venv\Scripts\Activate.ps1)
DATABASE_NAME=voice_assistant_db

# JWT settings
SECRET_KEY=change_this_to_a_long_random_secret_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS - frontend URL
FRONTEND_URL=http://localhost:5173

# Optional: OpenAI or Gemini keys for AI response generation.
# If left empty, the app uses built-in smart assistant commands.
OPENAI_API_KEY=
GEMINI_API_KEY=
